# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys. Leave both empty to run in local demo
# mode (data is stored only in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Optional: the email of the single household login you created in Supabase.
VITE_HOUSEHOLD_EMAIL=household@example.com

# console.anthropic.com → API Keys. Server-side only; never prefix with VITE_.
ANTHROPIC_API_KEY=
